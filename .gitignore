# Reverse .gitignore strategy:
# 1) Ignore everything by default
# 2) Explicitly allow only repository structure and source files

*

# Always keep this file visible to git
!.gitignore

# Top-level project metadata/docs
!.github/
!.github/**
!README.md
!README.ru.md
!CHANGELOG.md
!LICENSE
!MANIFEST.in
!SPEC.md
!pyproject.toml
!.pre-commit-config.yaml

# Python project structure
!astrageek/
!astrageek/**
!web/
!web/**
!frontend/
!frontend/**
!tools/
!tools/**
!sphinx/
!sphinx/**

# Rust workspace structure
!Cargo.toml
!Cargo.lock
!backend/
!backend/**
!rust-core/
!rust-core/**

# Explicitly keep local/editor/generated artifacts ignored
.cursor/
.vscode/
.idea/
__pycache__/
*.py[cod]
*.pyd
*.so
*.tmp
*.bak
*~
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local databases and temporary build/dev artifacts
apex.db
target/
build/
dist/
*.log
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/.vercel/

# Generated docs/artifacts
sphinx/_build/
README_PYPI.md