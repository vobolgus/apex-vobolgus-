# Reverse .gitignore strategy:
# 1) Ignore everything by default
# 2) Explicitly allow only repository structure and source files

*

# Always keep this file visible to git
!.gitignore

# Top-level project metadata/docs
!.github/
!.github/**
!README.md
!CHANGELOG.md
!LICENSE
!SPEC.md
!AGENTS.md

# Frontend (SvelteKit)
!frontend/
!frontend/**

# Rust workspace structure
!Cargo.toml
!Cargo.lock
!backend/
!backend/**
!rust-core/
!rust-core/**

# Top-level Node tooling
!package.json
!package-lock.json

# Explicitly keep local/editor/generated artifacts ignored
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local databases and temporary build/dev artifacts
apex.db
target/
build/
dist/
*.log
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/.vercel/
node_modules/

# Playwright runtime artifacts (keep baselines under e2e/)
frontend/e2e-results/
frontend/playwright-report/
frontend/test-results/
